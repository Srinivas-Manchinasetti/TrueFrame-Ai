# TrueFrame AI — Backend Environment Configuration

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection URI:
# Example: mongodb+srv://myUser:myPassword@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=TrueFrameAI
MONGODB_URI=

# MongoDB Database Name
MONGODB_DB_NAME=trueframe

# Inference Device ("cpu" or "cuda")
TRUEFRAME_DEVICE=cpu
