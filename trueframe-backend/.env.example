# TrueFrame AI — Backend Environment Configuration

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=TrueFrameAI
MONGODB_URI=

# MongoDB Database Name
MONGODB_DB_NAME=trueframe

# Inference Device ("cpu" or "cuda")
TRUEFRAME_DEVICE=cpu

# Clerk Secret Key (from Clerk Dashboard -> API Keys)
# Example: your_clerk_secret_key_here
CLERK_SECRET_KEY=

# Optional custom JWKS URL (defaults to https://api.clerk.com/v1/jwks)
CLERK_JWKS_URL=
